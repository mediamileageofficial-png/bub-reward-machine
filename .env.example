# ============================================================
# BUB Reward Machine — environment variables
# Copy to .env.local for local development. Never commit real secrets.
#
# Event facts, brand, Instagram, title sponsor and campaign status are all read by the
# central config: src/config/bub.ts. Server-only settings: src/config/server.ts.
#
# Amplify Hosting forbids the "AWS_" prefix: use the BUB_ aliases there
# (BUB_AWS_MOCK_MODE, BUB_AWS_REGION).
# ============================================================

# ---- Modes ----
AWS_MOCK_MODE=true              # true = in-memory data store + demo logins. false = DynamoDB + Cognito
WHATSAPP_MOCK_MODE=true         # KEEP true until templates are approved. Logs only; OTP is always 123456
SEED_DEMO_DATA=true             # load the DEMO data set (defaults to AWS_MOCK_MODE). Never true in production
ALLOW_MOCK_LOGIN=false          # production builds refuse demo logins unless this is true (staging demos only)
LOG_LEVEL=info                  # debug | info | warn | error | silent

# ---- App (server) ----
APP_BASE_URL=http://localhost:3000   # public URL; used for QR links, coupon links, Cognito redirects, origin checks
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars   # REQUIRED (32+ chars) when AWS_MOCK_MODE=false
CAMPAIGN_ID=bub-expo-2026
DEFAULT_PHONE_COUNTRY=IN
REWARD_HOLD_MINUTES=20               # how long a won box is reserved while the player verifies
SPONSOR_SELF_REDEMPTION=false        # V1: only BUB/Aurix admins redeem coupons
TRUST_PROXY_HEADERS=true             # use X-Forwarded-For for rate limiting (behind CloudFront/API GW)
# API_PROXY_URL=https://xxxx.execute-api.ap-south-1.amazonaws.com/prod   # route /api/* to API Gateway + Lambda

# ---- AWS ----
BUB_AWS_REGION=ap-south-1
DYNAMODB_TABLE_NAME=bub-reward-machine
# DYNAMODB_ENDPOINT=http://localhost:8000   # optional: DynamoDB Local
S3_ASSETS_BUCKET=                    # sponsor logos + story template artwork (private, served via CloudFront)
ASSETS_PUBLIC_BASE_URL=              # e.g. https://dxxxx.cloudfront.net
S3_TEMP_BUCKET=                      # private, 1-day lifecycle; selfies are NOT uploaded in V1

# ---- Cognito (admin + sponsor dashboards) ----
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=               # only if the app client has a secret
COGNITO_DOMAIN=                      # e.g. https://bub-admin.auth.ap-south-1.amazoncognito.com

# ---- WhatsApp (server only; used when WHATSAPP_MOCK_MODE=false) ----
WHATSAPP_PROVIDER=meta_cloud         # meta_cloud | msg91
WHATSAPP_ALLOWED_COUNTRIES=IN        # OTPs only go to numbers from these countries
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_OTP=bub_otp                    # authentication template: {{1}} = code, copy-code button
WHATSAPP_TEMPLATE_REWARD=bub_reward_won          # {{1}} name, {{2}} reward, {{3}} sponsor
WHATSAPP_TEMPLATE_COUPON=bub_coupon_code         # {{1}} name, {{2}} code, {{3}} reward, {{4}} valid until, {{5}} coupon link
WHATSAPP_TEMPLATE_REMINDER=bub_event_reminder    # {{1}} name, {{2}} event, {{3}} dates, {{4}} venue
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5
# Meta WhatsApp Cloud API
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_ACCESS_TOKEN=               # secret — never commit
WHATSAPP_PHONE_NUMBER_ID=
# MSG91
MSG91_API_BASE_URL=https://api.msg91.com
MSG91_AUTH_KEY=                      # secret — never commit
MSG91_INTEGRATED_NUMBER=
MSG91_TEMPLATE_NAMESPACE=

# ---- Public: central config (src/config/bub.ts) — these reach the browser, never put secrets here ----
NEXT_PUBLIC_CAMPAIGN_STATUS=live               # live | paused (no new plays) | ended
NEXT_PUBLIC_CAMPAIGN_STATUS_MESSAGE=           # optional banner text when paused/ended
NEXT_PUBLIC_EVENT_NAME=BUB Expo 2026
NEXT_PUBLIC_EVENT_SHORT_NAME=BUB
NEXT_PUBLIC_EVENT_YEAR=2026
NEXT_PUBLIC_EVENT_DATES_LABEL=15–17 October 2026
NEXT_PUBLIC_EVENT_DATES_SHORT=15–17 OCT
NEXT_PUBLIC_EVENT_START_DATE=2026-10-15        # event-local dates; default coupon redemption window
NEXT_PUBLIC_EVENT_END_DATE=2026-10-17
NEXT_PUBLIC_EVENT_TIMEZONE=Asia/Kolkata        # daily reward limits reset at local midnight
NEXT_PUBLIC_EVENT_UTC_OFFSET_MINUTES=330
NEXT_PUBLIC_EVENT_VENUE=Sree Varalakshmi Mahal, Salem
NEXT_PUBLIC_EVENT_VENUE_SHORT=Sree Varalakshmi Mahal
NEXT_PUBLIC_EVENT_CITY=Salem
NEXT_PUBLIC_ORGANIZER_NAME=Aurix Events
NEXT_PUBLIC_STORY_HASHTAG=#MyBUBStory
NEXT_PUBLIC_STORY_MAX_PHOTO_MB=15
NEXT_PUBLIC_BRAND_BACKGROUND=#F3EEE4
NEXT_PUBLIC_BRAND_ORANGE=#F0440F
NEXT_PUBLIC_BUB_LOGO_URL=            # empty = placeholder wordmark
NEXT_PUBLIC_HERO_IMAGE_URL=          # optional campaign photo behind the landing hero
NEXT_PUBLIC_TERMS_URL=               # organiser's terms page (legal copy is not invented here)
NEXT_PUBLIC_TITLE_SPONSOR_NAME=Title Sponsor
NEXT_PUBLIC_TITLE_SPONSOR_LOGO_URL=
NEXT_PUBLIC_INSTAGRAM_BUB_URL=https://www.instagram.com/
NEXT_PUBLIC_INSTAGRAM_BUB_HANDLE=BUB Expo
NEXT_PUBLIC_INSTAGRAM_ORGANIZER_URL=https://www.instagram.com/
NEXT_PUBLIC_INSTAGRAM_ORGANIZER_HANDLE=Aurix Events
NEXT_PUBLIC_INSTAGRAM_TITLE_SPONSOR_URL=https://www.instagram.com/
NEXT_PUBLIC_INSTAGRAM_TITLE_SPONSOR_HANDLE=Title Sponsor
NEXT_PUBLIC_API_BASE_URL=            # empty = same origin (recommended)
